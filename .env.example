# Supabase PostgreSQL Database
# Replace [YOUR-PASSWORD] and [YOUR-PROJECT-REF] with your actual Supabase credentials
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ----- Auth -----
# JWT secret for session cookies (HS256). Must be >= 32 characters.
JWT_SECRET="replace-me-with-a-long-random-secret"

# ----- CliQ payments (Jordan instant payments / JoPACC) -----
# When these are NOT set, payments run in sandbox mode (instant simulated approval).
CLIQ_API_URL="https://api.developer.bankaletihad.com/api/v1/partner/cliq/payment"
CLIQ_TOKEN_URL="https://auth.developer.bankaletihad.com/oauth2/token"
CLIQ_CLIENT_ID=""
CLIQ_CLIENT_SECRET=""
CLIQ_SCOPE="cliq.payment"
# mTLS client certificates (paths readable by the server) — required by Bank Al Etihad
CLIQ_CLIENT_CERT=""
CLIQ_CLIENT_KEY=""
CLIQ_CA_CERT=""
# Shared secret used to verify the webhook HMAC signature
CLIQ_WEBHOOK_SECRET=""

# ----- SMS (Twilio) -----
# When UNCONFIGURED, OTP codes and notifications are logged to the console (dev mode).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_FROM=""

# ----- App -----
# Public base URL (used for payment callback/checkout links)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

