# ═══════════════════════════════════════════════════════════════════════════
# Expats WakeelyPro — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
#
# Copy this file to `.env` and fill in your real values.
# On Vercel, set these in Project Settings → Environment Variables.
#
# Generate secrets with:
#   openssl rand -hex 32
# ═══════════════════════════════════════════════════════════════════════════


# ─── Database (Supabase) ────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → Database → Connection string
#
# DATABASE_URL:  The pooled connection string (uses port 6543, pgBouncer).
#                Used by the app at runtime (serverless-friendly).
# DIRECT_URL:    The direct connection string (uses port 5432).
#                Used by Prisma for migrations (cannot use pgBouncer).
#
# Both must end with: ?pgbouncer=true&connection_limit=1
# (Supabase requires this for Prisma in serverless environments.)

DATABASE_URL="postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project>:<password>@aws-0-<region>.supabase.com:5432/postgres"


# ─── Auth ───────────────────────────────────────────────────────────────────
# JWT secret for signing session cookies. MUST be at least 32 characters.
# Generate with: openssl rand -hex 32

JWT_SECRET="change-me-to-a-random-32-char-string-please"


# ─── Supabase Storage (for document uploads) ────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
#
# SUPABASE_URL:               Your project URL (https://<project>.supabase.co)
# SUPABASE_SERVICE_ROLE_KEY:  The server-side key (bypasses RLS). Keep secret!

SUPABASE_URL="https://<project>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."


# ─── SMS Provider (for phone OTP) ───────────────────────────────────────────
# Optional in dev mode (codes are logged to console + returned in API response).
# Required for production: get these from your Twilio console.
#
# If not set, OTP codes are logged to the server console (dev mode only).
# In production, ALWAYS set these — otherwise users can't receive SMS codes.

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_FROM=""


# ─── App Config ─────────────────────────────────────────────────────────────
# Public-facing URL of the deployed app.
# On Vercel, this is automatically set to your deployment URL.

NEXT_PUBLIC_APP_URL="http://localhost:3000"


# ─── Payment Provider (optional, Phase 2) ───────────────────────────────────
# Not required for Phase 1 — payments are simulated (status: PAID immediately).
# For real payments, integrate Stripe / PayTabs / Moyasar and set these.

# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PUBLISHABLE_KEY=""
