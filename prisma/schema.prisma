// Expats WakeelyPro — Jordan Remote Legal Services
// SQLite schema — development/demo-ready
// Adapted from PostgreSQL for local development

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "sqlite"
  url       = env("DATABASE_URL")
}

// ----- Enums -----

enum Role {
  CITIZEN
  LAWYER
  ADMIN
}

enum Language {
  ar
  en
}

enum MatterStatus {
  new_matter
  intake
  awaiting_documents
  lawyer_requested
  lawyer_assigned
  consultation_scheduled
  active
  resolved
  closed
  service_recommended
  remote_eligibility_check
  documents_pending
  documents_received
  in_progress
  in_review
  filing_prepared
  filed_with_authority
  authority_processing
  ready_for_delivery
  delivered
  cancelled
}

enum RemoteEligibility {
  fully_remote
  partially_remote
  in_person_required
  unknown
}

enum MatterTaskStatus {
  pending
  in_progress
  completed
  blocked
  skipped
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentKind {
  platform_fee
  lawyer_fee
  government_fee
  disbursement
}

enum ConversationKind {
  lead
  matter
  direct
}

enum NotificationKind {
  new_message
  document_uploaded
  matter_status_changed
  task_completed
  task_assigned
  payment_received
  deadline_approaching
  lawyer_assigned
  matched_lawyer
}

enum IntakeStatus {
  in_progress
  completed
  abandoned
}

// ----- Core user model -----

model User {
  id         String   @id @default(cuid())
  phone      String   @unique
  email      String?  @unique
  name       String
  role       Role     @default(CITIZEN)
  language   Language @default(ar)
  isVerified Boolean  @default(false)
  currentCountry String?
  currentCity    String?
  clientStatus   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lawyerProfile     LawyerProfile?
  legalMatters      LegalMatter[]     @relation("UserMatters")
  matterDocuments   MatterDocument[]  @relation("UserMatterDocs")
  legalIntakes      LegalIntake[]
  conversations     Conversation[]    @relation("UserConversations")
  sentMessages      Message[]
  notifications     Notification[]
  payments          Payment[]

  @@index([role])
}

// ----- Lawyer profile -----

model LawyerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  barNumber       String   @unique
  bioAr           String
  bioEn           String
  specialties     String   @default("[]") // JSON array
  cities          String   @default("[]") // JSON array
  hourlyRate      Int      @default(0)
  yearsExperience Int      @default(0)
  languages       String   @default("[\"ar\"]") // JSON array of Language
  verified        Boolean  @default(false)
  isAvailable     Boolean  @default(true)
  rating          Float    @default(0)
  totalReviews    Int      @default(0)
  avatarUrl       String?
  handlesRemoteMatters Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedMatters  LegalMatter[]   @relation("LawyerMatters")
  practiceAreas    LawyerPracticeArea[]
  conversations    Conversation[]  @relation("LawyerConversations")

  @@index([verified])
  @@index([isAvailable])
}

model LawyerPracticeArea {
  id              String   @id @default(cuid())
  lawyerProfileId String
  practiceAreaId  String
  isPrimary       Boolean  @default(false)
  createdAt        DateTime @default(now())

  lawyerProfile LawyerProfile @relation(fields: [lawyerProfileId], references: [id], onDelete: Cascade)
  practiceArea  PracticeArea  @relation(fields: [practiceAreaId], references: [id], onDelete: Cascade)

  @@unique([lawyerProfileId, practiceAreaId])
  @@index([lawyerProfileId])
  @@index([practiceAreaId])
}

model PracticeArea {
  id          String   @id @default(cuid())
  slug        String   @unique
  nameAr      String
  nameEn      String
  descriptionAr String?
  descriptionEn String?
  parentId    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parent            PracticeArea?          @relation("PracticeAreaHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children          PracticeArea[]         @relation("PracticeAreaHierarchy")
  matters           LegalMatter[]
  legalServices     LegalService[]
  lawyerProfiles    LawyerPracticeArea[]

  @@index([parentId])
  @@index([isActive])
}

model Jurisdiction {
  id         String   @id @default(cuid())
  code       String   @unique
  nameAr     String
  nameEn     String
  country    String
  region     String?
  city       String?
  parentId   String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  parent       Jurisdiction?    @relation("JurisdictionHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Jurisdiction[]   @relation("JurisdictionHierarchy")
  matters      LegalMatter[]

  @@index([country])
  @@index([parentId])
}

// ----- Service Catalog -----

model LegalService {
  id              String   @id @default(cuid())
  slug            String   @unique
  code            String   @unique
  nameAr          String
  nameEn          String
  shortAr         String
  shortEn         String
  descriptionAr   String
  descriptionEn   String
  practiceAreaId  String?
  defaultRemoteEligibility RemoteEligibility @default(partially_remote)
  platformFeeDefault      Int @default(25)
  lawyerFeeMin            Int @default(150)
  lawyerFeeMax            Int @default(800)
  governmentFeeEstimate   Int @default(0)
  governmentFeeNoteAr     String?
  governmentFeeNoteEn     String?
  typicalDurationDays     Int   @default(30)
  isActive        Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  practiceArea       PracticeArea?               @relation(fields: [practiceAreaId], references: [id], onDelete: SetNull)
  procedures         LegalProcedure[]
  documentRequirements LegalDocumentRequirement[]
  matters            LegalMatter[]
  officialSources    LegalServiceOfficialSource[]

  @@index([isActive])
  @@index([practiceAreaId])
}

model LegalProcedure {
  id              String   @id @default(cuid())
  legalServiceId  String
  slug            String   @unique
  nameAr          String
  nameEn          String
  remoteEligibility RemoteEligibility @default(partially_remote)
  remoteEligibilityReasonAr String
  remoteEligibilityReasonEn String
  physicalPresenceSteps Json   @default("[]")
  remoteSteps           Json   @default("[]")
  authorityAr   String?
  authorityEn   String?
  estimatedDurationDays Int @default(30)
  legalBasisAr  String?
  legalBasisEn  String?
  notesAr       String?
  notesEn       String?
  sortOrder     Int     @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  legalService LegalService @relation(fields: [legalServiceId], references: [id], onDelete: Cascade)
  matters      LegalMatter[]

  @@index([legalServiceId])
}

model LegalDocumentRequirement {
  id              String   @id @default(cuid())
  legalServiceId  String
  slug            String
  nameAr          String
  nameEn          String
  descriptionAr   String?
  descriptionEn   String?
  isRequired      Boolean  @default(true)
  provider        String   @default("client")
  stage           String   @default("at_intake")
  acceptsDigital  Boolean  @default(true)
  requiresOriginal   Boolean @default(false)
  requiresNotarization Boolean @default(false)
  requiresApostille  Boolean @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  legalService LegalService @relation(fields: [legalServiceId], references: [id], onDelete: Cascade)

  @@unique([legalServiceId, slug])
  @@index([legalServiceId])
}

model OfficialSource {
  id          String   @id @default(cuid())
  slug        String   @unique
  nameAr      String
  nameEn      String
  url         String?
  authorityType String
  country     String   @default("Jordan")
  region      String?
  notesAr     String?
  notesEn     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  legalServices LegalServiceOfficialSource[]
}

model LegalServiceOfficialSource {
  id              String   @id @default(cuid())
  legalServiceId  String
  officialSourceId String
  relationType   String   @default("primary")
  notesAr        String?
  notesEn        String?
  createdAt      DateTime @default(now())

  legalService   LegalService   @relation(fields: [legalServiceId], references: [id], onDelete: Cascade)
  officialSource OfficialSource @relation(fields: [officialSourceId], references: [id], onDelete: Cascade)

  @@unique([legalServiceId, officialSourceId])
  @@index([legalServiceId])
  @@index([officialSourceId])
}

// ----- Legal Matter -----

model LegalMatter {
  id              String       @id @default(cuid())
  title           String
  clientId        String
  lawyerId        String?
  status          MatterStatus @default(new_matter)
  facts           String?
  aiAnalysis      String?
  notes           String?
  lawyerNotes     String?
  deadline        DateTime?
  practiceAreaId  String?
  jurisdictionId  String?
  country         String?
  region          String?
  city            String?
  urgency         String?

  legalServiceId  String?
  legalProcedureId String?
  remoteEligibility RemoteEligibility @default(unknown)
  remoteEligibilityReasonAr String?
  remoteEligibilityReasonEn String?

  clientCountry   String?
  clientCity      String?
  clientStatus    String?

  platformFeeJOD  Int @default(0)
  lawyerFeeJOD    Int @default(0)
  governmentFeeJOD Int @default(0)
  governmentFeeIncluded Boolean @default(false)
  feeNotesAr      String?
  feeNotesEn      String?

  progressPercent Int @default(0)
  intakeId        String? @unique

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  closedAt         DateTime?

  client       User           @relation("UserMatters", fields: [clientId], references: [id], onDelete: Cascade)
  lawyer       LawyerProfile?  @relation("LawyerMatters", fields: [lawyerId], references: [id], onDelete: SetNull)
  practiceArea PracticeArea?  @relation(fields: [practiceAreaId], references: [id], onDelete: SetNull)
  jurisdiction Jurisdiction?  @relation(fields: [jurisdictionId], references: [id], onDelete: SetNull)
  legalService LegalService?  @relation(fields: [legalServiceId], references: [id], onDelete: SetNull)
  legalProcedure LegalProcedure? @relation(fields: [legalProcedureId], references: [id], onDelete: Cascade)
  documents    MatterDocument[]
  tasks        MatterTask[]
  timelineEvents MatterTimelineEvent[]
  conversations Conversation[]
  payments     Payment[]
  intake       LegalIntake?

  @@index([clientId])
  @@index([lawyerId])
  @@index([status])
  @@index([legalServiceId])
  @@index([createdAt])
}

model MatterDocument {
  id          String   @id @default(cuid())
  matterId    String
  uploadedById String
  fileName    String
  fileUrl     String
  fileType    String
  fileSize    Int       @default(0)
  description String?
  requirementSlug String?
  aiAnalysis  String?
  reviewStatus   String?
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNotes    String?
  createdAt    DateTime @default(now())

  matter     LegalMatter @relation(fields: [matterId], references: [id], onDelete: Cascade)
  uploadedBy User        @relation("UserMatterDocs", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([matterId])
  @@index([requirementSlug])
  @@index([reviewStatus])
}

model MatterTask {
  id          String   @id @default(cuid())
  matterId    String
  titleAr     String
  titleEn     String
  descriptionAr String?
  descriptionEn String?
  status      MatterTaskStatus @default(pending)
  sortOrder   Int      @default(0)
  responsibleRole String @default("lawyer")
  assignedLawyerId String?
  dueDate     DateTime?
  completedAt DateTime?
  requiresPhysicalPresence Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  matter LegalMatter @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@index([matterId])
  @@index([status])
}

model MatterTimelineEvent {
  id          String   @id @default(cuid())
  matterId    String
  eventType   String
  titleAr     String
  titleEn     String
  descriptionAr String?
  descriptionEn String?
  actorId     String?
  actorRole   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  matter LegalMatter @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@index([matterId])
  @@index([createdAt])
}

// ----- Legal Intake -----

model LegalIntake {
  id            String       @id @default(cuid())
  userId        String
  status        IntakeStatus @default(in_progress)
  language      Language     @default(ar)
  rawText       String
  structured    Json?
  pendingQuestion String?
  pendingQuestionId String?
  finalSummary      String?
  recommendedPracticeAreaId String?
  recommendedJurisdictionId String?
  recommendedLegalServiceId String?
  recommendedRemoteEligibility RemoteEligibility @default(unknown)
  recommendedDocumentSlugs Json?
  confidence        Float    @default(0)
  safetyFlags       String   @default("[]") // JSON array
  promptVersion   String    @default("legal_intake_v1")
  model          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt     DateTime?

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  matter         LegalMatter?    @relation(fields: [matterId], references: [id], onDelete: SetNull)
  matterId   String?  @unique

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ----- Messaging -----

model Conversation {
  id          String           @id @default(cuid())
  kind        ConversationKind @default(direct)
  clientUserId String
  lawyerId     String?
  matterId     String?
  lastMessageAt DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  clientUser User           @relation("UserConversations", fields: [clientUserId], references: [id], onDelete: Cascade)
  lawyer     LawyerProfile?  @relation("LawyerConversations", fields: [lawyerId], references: [id], onDelete: SetNull)
  matter     LegalMatter?    @relation(fields: [matterId], references: [id], onDelete: SetNull)
  messages   Message[]

  @@index([clientUserId])
  @@index([lawyerId])
  @@index([matterId])
}

model Message {
  id          String   @id @default(cuid())
  conversationId String
  senderId    String
  body        String
  attachments Json?
  readAt      DateTime?
  createdAt   DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ----- Notifications -----

model Notification {
  id        String           @id @default(cuid())
  userId    String
  kind      NotificationKind
  title     String
  body      String?
  link      String?
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
}

// ----- Payments -----

model Payment {
  id          String        @id @default(cuid())
  userId      String
  matterId    String?
  amountJOD   Int
  kind        PaymentKind   @default(platform_fee)
  status      PaymentStatus @default(PENDING)
  providerRef String?
  providerName String?
  description String?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  matter LegalMatter? @relation(fields: [matterId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([matterId])
  @@index([status])
}

// ----- OTP Challenges -----

model OtpChallenge {
  id        String   @id @default(cuid())
  phone     String
  code      String
  attempts  Int      @default(0)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
}
